# Shopify Storefront API (laisser vide = mode démo, aucun paiement)
# Clé Storefront : Shopify → Paramètres → Applications → Développer des applications → ton app → Storefront API
SHOPIFY_STOREFRONT_TOKEN=

# Facultatif : déjà réglés dans lib/shopify.ts (boutique jsgvit-dt et produits JustMyRide)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_VARIANT_SCALE_43=
SHOPIFY_VARIANT_SCALE_24=
SHOPIFY_VARIANT_SCALE_18=
SHOPIFY_VARIANT_BASE=
SHOPIFY_VARIANT_CASE=

# Stockage des photos (ajouté automatiquement par Vercel quand un store Blob est connecté)
# Connexion Blob actuelle (OIDC) : Vercel ajoute BLOB_STORE_ID et BLOB_WEBHOOK_PUBLIC_KEY tout seul.
# Ancienne connexion : BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# "private" par défaut ; mettre "public" seulement si le store Blob est public
NEXT_PUBLIC_BLOB_ACCESS=private

# Sketchfab : clé API du compte de la boutique, pour télécharger les modèles 3D choisis dans le garage
# (sketchfab.com → Settings → Password & API → API Token)
SKETCHFAB_API_TOKEN=

# Alerte e-mail à chaque demande de photos (Resend). Sans ces deux variables : pas d'e-mail.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Facultatif : expéditeur (doit être un domaine vérifié sur Resend)
RESEND_FROM=

# Génération 3D Meshy (photos → modèle). Lancée à la main uniquement, jamais par un client.
# Clé : meshy.ai → API → API Keys. À mettre seulement dans Vercel, jamais dans le code.
MESHY_API_KEY=
# Mot de passe à envoyer dans l'en-tête x-admin-token pour lancer une génération (longue chaîne aléatoire)
ADMIN_TOKEN=
# Mot de passe de la page /admin (tableau de bord). Sert aussi de clé pour signer la session : ADMIN_TOKEN doit être rempli.
ADMIN_PASSWORD=
# Garde-fous : nombre maximum de générations par jour et par mois (2 et 10 par défaut)
MESHY_DAILY_LIMIT=2
MESHY_MONTHLY_LIMIT=10
# "1" pour demander la texture à Meshy (coûte plus de crédits)
MESHY_TEXTURE=

# Analyse automatique des photos (Claude compare les photos à la voiture de base)
ANTHROPIC_API_KEY=
# Modèle utilisé pour l'analyse (claude-sonnet-5-5 par défaut ; claude-haiku-5-5 pour moins cher)
ANALYSE_MODEL=
ANALYSE_DAILY_LIMIT=20
ANALYSE_MONTHLY_LIMIT=200
