# Adresse publique du site (URL canoniques, sitemap, données structurées). Vide = https://justemyride.vercel.app
# À remplir avec https://www.justmyride.shop (ou le domaine choisi) seulement quand le domaine est acheté et branché.
NEXT_PUBLIC_SITE_URL=
# Facultatif : code de la balise HTML de Google Search Console (méthode « balise HTML »), sans les guillemets
GOOGLE_SITE_VERIFICATION=

# Shopify Storefront API (laisser vide = mode démo, aucun paiement)
# Clé Storefront : Shopify → Paramètres → Applications → Développer des applications → ton app → Storefront API
SHOPIFY_STOREFRONT_TOKEN=

# Facultatif : déjà réglés dans lib/shopify.ts (boutique jsgvit-dt et produits JustMyRide)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_VARIANT_SCALE_43=
SHOPIFY_VARIANT_SCALE_24=
SHOPIFY_VARIANT_SCALE_18=
SHOPIFY_VARIANT_BASE=
SHOPIFY_VARIANT_CASE=

# Stockage Cloudflare R2 (10 Go gratuits) : prioritaire dès que ces 4 variables sont remplies, sinon Vercel Blob.
# Cloudflare → R2 → le bucket ; clés : R2 → « Gérer les jetons d'API » → jeton « Lecture et écriture d'objets ».
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Connexion client (Supabase, projet « justmyride ») : 1 aperçu gratuit par personne, les suivants à 5 €.
# Vides = pas de connexion, envoi libre comme avant.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "1" pour afficher « Continuer avec Google » (fournisseur Google réglé dans Supabase)
NEXT_PUBLIC_AUTH_GOOGLE=
# Facultatif : anti-robot Cloudflare Turnstile (clé du site ; la clé secrète se met dans Supabase → Auth → Bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Webhook Shopify « Paiement de commande » → https://<site>/api/shopify/webhook : ajoute l'aperçu payé au client
SHOPIFY_WEBHOOK_SECRET=
# Facultatif : produit « Aperçu 3D supplémentaire » (déjà réglé dans lib/shopify.ts)
SHOPIFY_VARIANT_APERCU=

# Ancien stockage Vercel Blob (ajouté automatiquement par Vercel quand un store Blob est connecté)
# Connexion Blob actuelle (OIDC) : Vercel ajoute BLOB_STORE_ID et BLOB_WEBHOOK_PUBLIC_KEY tout seul.
# Ancienne connexion : BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# "private" par défaut ; mettre "public" seulement si le store Blob est public
NEXT_PUBLIC_BLOB_ACCESS=private

# Sketchfab : clé API du compte de la boutique, pour télécharger les modèles 3D choisis dans le garage
# (sketchfab.com → Settings → Password & API → API Token)
SKETCHFAB_API_TOKEN=

# Alerte e-mail à chaque demande de photos (Resend). Sans ces deux variables : pas d'e-mail.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Facultatif : expéditeur (doit être un domaine vérifié sur Resend)
RESEND_FROM=

# Accès admin : ADMIN_TOKEN = longue chaîne aléatoire (signe la session, accepté aussi en en-tête x-admin-token)
ADMIN_TOKEN=
# Mot de passe de la page /admin (tableau de bord). ADMIN_TOKEN doit être rempli.
ADMIN_PASSWORD=

# Analyse automatique des photos (Claude compare les photos à la voiture de base)
ANTHROPIC_API_KEY=
# Modèle utilisé pour l'analyse (claude-sonnet-5-5 par défaut ; claude-haiku-5-5 pour moins cher)
ANALYSE_MODEL=
ANALYSE_DAILY_LIMIT=40
ANALYSE_MONTHLY_LIMIT=400

# Meshy : refait les pièces essentielles qui manquent (4 au maximum par commande), lancé à la main depuis l'admin.
# Clé : meshy.ai → API → API Keys. À mettre seulement dans Vercel.
MESHY_API_KEY=
# Garde-fous : nombre maximum de pièces générées par jour et par mois (8 et 40 par défaut)
MESHY_PIECES_DAILY_LIMIT=8
MESHY_PIECES_MONTHLY_LIMIT=40

# Facultatif : secret que Vercel envoie au réveil quotidien de Supabase (/api/cron/supabase, vercel.json)
CRON_SECRET=
